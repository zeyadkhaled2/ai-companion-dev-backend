{
  "name": "ai-dev-companion-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "ts-node-dev --respawn src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "npm run format:check && npm run typecheck && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.cjs\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "prettier": "3.9.10",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
